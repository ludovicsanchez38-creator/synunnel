# Exemple de /etc/synunnel/synunnel.env. Le fichier réel est écrit par scripts/install.sh,
# avec des secrets aléatoires. Ne jamais placer de vraies valeurs dans le dépôt.
SECRET_KEY=valeur-aleatoire-longue
ADMIN_TOKEN=valeur-aleatoire-longue
PDNS_API_KEY=valeur-aleatoire-longue
PDNS_API_URL=http://127.0.0.1:8081/api/v1/servers/localhost
DATABASE=/var/lib/synunnel/synunnel.db
PUBLIC_IPV4=203.0.113.10
PUBLIC_IPV6=
WG_ENDPOINT=203.0.113.10:51820
WG_SERVER_PUBLIC_KEY=cle-publique-wireguard
DASHBOARD_HOST=tunnel.example.org
NS1_HOST=ns1.example.org
NS2_HOST=ns2.example.org
SOA_RNAME=hostmaster.tunnel.example.org.
REDIRECT_HOSTS=
ACME_EMAIL=admin@example.org
SYNC_COMMAND='/usr/bin/sudo -n /usr/local/sbin/synunnel-sync'
