# Synunnel managed. Généré depuis la configuration par scripts/install.sh.
{
    email __ACME_EMAIL__
    on_demand_tls {
        ask http://127.0.0.1:8000/internal/caddy/ask
    }
}

https:// {
    tls {
        on_demand
    }
    @synunnel_dashboard host __DASHBOARD_HOST__
    handle @synunnel_dashboard {
        @synunnel_dashboard_internal path /internal/*
        handle @synunnel_dashboard_internal {
            respond 404
        }
        handle {
            reverse_proxy 127.0.0.1:8000 {
                header_up X-Real-IP {remote_host}
            }
        }
    }
    @synunnel_redirect host __REDIRECT_HOSTS__
    handle @synunnel_redirect {
        redir https://__DASHBOARD_HOST__{uri} 308
    }
    import /etc/caddy/synunnel-routes.caddy
    handle {
        respond "Adresse inconnue" 403
    }
}
