# Synunnel managed. Généré depuis la configuration par scripts/install.sh.
{
    # API d'administration sur un socket dans /run/caddy (0750, propriétaire caddy) : l'utilisateur
    # de l'application ne peut pas reconfigurer Caddy, seul root y passe via systemctl reload.
    admin unix//run/caddy/admin.sock
    # Journaux expurgés, erreurs comprises (un 502 journalise la requête) : ni jeton de lien ou de
    # transfert dans l'URI (token, code), ni cookie, ni en-tête d'autorisation.
    log default {
        format filter {
            wrap json
            fields {
                request>uri query {
                    replace token REDACTED
                    replace code REDACTED
                }
                request>headers>Cookie delete
                request>headers>Authorization delete
            }
        }
    }
    email __ACME_EMAIL__
    on_demand_tls {
        ask http://127.0.0.1:8000/internal/caddy/ask
    }
}

https:// {
    tls {
        on_demand
    }
    @synunnel_dashboard host __DASHBOARD_HOST__
    handle @synunnel_dashboard {
        @synunnel_dashboard_internal path /internal/*
        handle @synunnel_dashboard_internal {
            respond 404
        }
        # L'API d'administration ne s'appelle qu'en local, sur 127.0.0.1:8000 (voir docs/API-ADMIN.md).
        @synunnel_dashboard_admin path /admin/*
        handle @synunnel_dashboard_admin {
            respond 404
        }
        handle {
            reverse_proxy 127.0.0.1:8000 {
                header_up X-Real-IP {remote_host}
                # Caddy garde son propre en-tête Server ; celui de gunicorn n'apprendrait rien d'utile au visiteur.
                header_down -Server
            }
        }
    }
    # __REDIRECT_START__
    @synunnel_redirect host __REDIRECT_HOSTS__
    handle @synunnel_redirect {
        redir https://__DASHBOARD_HOST__{uri} 308
    }
    # __REDIRECT_END__
    import /etc/caddy/synunnel-routes.caddy
    handle {
        respond "Adresse inconnue" 403
    }
}
